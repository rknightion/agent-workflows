#!/usr/bin/env python3
"""Run one tracker command with a freshly minted GitHub App installation token (README.md, Identities).

    with-token view 123
    with-token status 123 --file note.md

TRACKER_APP_CRED names a directory of the credentials tree,
${CREDENTIALS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/tracker/credentials}/github/<TRACKER_APP_CRED>/, holding `app.env`
(GITHUB_APP_ID, and GITHUB_APP_SLUG when the App has one) and `private-key.pem`. appmint.py (beside this file)
signs an App JWT with `openssl` reading the key where it lies, finds the App's installation on the tracker's
repository (GET /repos/<owner>/<name>/installation) and mints an installation token scoped to that one
repository. The tracker then runs in this process with TRACKER_APP_TOKEN set in the tracker's own settings only.
The key is never copied; the JWT and the token are never printed, logged, put in an argument or exported to this
process's environment, and there is no mode that prints a token. When TRACKER_APP_LOGIN is unset it becomes
`<GITHUB_APP_SLUG>[bot]`, read from app.env or, failing that, from GET /app. The exit status is the tracker's;
minting failures exit 2 (setting) or 4 (GitHub).
"""
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
import appmint  # noqa: E402  (the sibling modules, found through the line above)
import tracker  # noqa: E402
from appmint import SETTING, MintError, credential_dir, make_jwt, mint, read_env_file  # noqa: E402,F401


def main(argv=None, env=None, stdin=None, out=None, err=None, cwd=None, now=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    env = dict(os.environ if env is None else env)
    err = err or sys.stderr
    cwd = cwd or os.getcwd()
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__, file=out or sys.stdout)
        return 0 if argv else SETTING
    try:
        try:
            parsed = tracker.build_parser().parse_args(argv)
            repo = tracker.resolve_repo(getattr(parsed, "repo", None), env, cwd)
        except tracker.Fail as failure:
            raise MintError(failure.code, str(failure)) from None
        token, login = appmint.mint(env, repo, now)
    except MintError as failure:
        print(f"with-token: {failure}", file=err)
        return failure.code
    settings = dict(env, TRACKER_APP_TOKEN=token)
    if login and not settings.get("TRACKER_APP_LOGIN"):
        settings["TRACKER_APP_LOGIN"] = login
    return tracker.main(argv, env=settings, stdin=stdin, out=out, err=err, cwd=cwd)


if __name__ == "__main__":
    sys.exit(main())
