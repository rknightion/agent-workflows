#!/usr/bin/env python3.15
"""Retired App-token wrapper, kept so every tracker recipe that runs tracker-with-token keeps working.

It reads no credentials and mints nothing: it runs the tracker with the same arguments as the ambient gh login.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import tracker  # noqa: E402

if __name__ == "__main__":
    sys.exit(tracker.main(sys.argv[1:]))
