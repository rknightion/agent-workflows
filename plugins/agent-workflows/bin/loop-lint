#!/usr/bin/env python3
"""Lint loop files: loop-lint loopmd <LOOP.md> | charter <charter.md> | queue <charter.md> <QUEUE.md>.

`charter` checks the v3 charter shape (sources/loop/charter.md): the `# Charter: <repo> loop<N>` header,
the required keys (harness, root, aim, priorities, exclude, lanes, gate, gate-route, standing, overnight),
a `## First wave` table, at most 8 KB, and a `standing:` file that exists with the recorded sha256.
`queue` reads task IDs from the ready rows of a QUEUE.md and fails any ID in the charter's `exclude:`
list, any Done task and any task carrying an excluded label. Ready rows are the table rows and list items
under a `## Ready` heading, or, with no such heading, every row outside the Hold, Landing and Done
sections; the first task ID of a row is the row's task. `needs-owner` is always an excluded label. Each ID
is read with `backlog task view <id> --plain` in the repository that owns the charter (the parent of its
`codex/` directory, or --repo).
`loopmd` checks a repository's LOOP.md.

Messages are `<rule> <path>:<line> <text>`; an informational line carries `info:` (or `warning:`)
after the location and never fails the run. Exit 1 on any error, 2 on a usage error.

`--offline` skips the checks that need `gh` (loopmd's L2 required-check comparison and main's CI read)
and prints that it skipped them.

`baseline-red: <TASK-ID> - <reason>` in LOOP.md marks main as known red. Online, L2 reads the required
checks on main's head and warns when the key looks stale (all green) or is missing (one failed); an
unreadable or undecided answer is info.

Required checks are read only for a github.com origin, deciding on HTTP status codes: the rulesets
endpoint must answer 200, and classic protection's 404 `Branch not protected` is the only 404 read as
none. Any other origin is `not verifiable (not on GitHub)`, which L2 says as info. A skipped or
neutral CI run is not a pass.
"""
import argparse
import csv
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys

CHARTER_MAX = 8192
FIRST_WAVE_ROWS = 20
CHARTER_KEYS = ('harness', 'root', 'aim', 'priorities', 'exclude', 'lanes', 'gate', 'gate-route', 'standing',
                'overnight')
HARNESSES = ('claude', 'codex', 'pi', 'claude-openai')
CHARTER_HEADER = re.compile(r'^# Charter: (\S+) loop(\d+)$')
CHARTER_FILE = re.compile(r'^charter-.*-loop(\d+)\.md$')
PLACEHOLDER = re.compile(r'(?<!\S)<[A-Za-z][^<>]*>(?!\S)')
STANDING_VALUE = re.compile(r'^(/\S+)\s+sha256=([0-9a-f]{64})$')
BUDGET_VALUE = re.compile(r'^(?:none|\d{4}-\d\d-\d\dT\d\d:\d\d(?::\d\d)?Z)$')
TASK_ID = re.compile(r'(?<![\w-])[A-Z][A-Z0-9]*-\d+(?:\.\d+)*(?![\w-])')
EXCLUDE_LABEL = re.compile(r'label:\s*([^\s,;()]+)')
ALWAYS_EXCLUDED_LABELS = ('needs-owner',)
NOT_READY_SECTION = re.compile(r'^(?:hold|held|park|landing|landed|done|blocked)', re.IGNORECASE)
LIST_ITEM = re.compile(r'^\s*(?:[-*+]|\d+[.)])\s+')

LOOPMD_MAX = 6144
PROTOCOL_POINTERS = (
    (re.compile(r'§\s*\d'), 'section pointer'),
    (re.compile(r'Appendix [ABC]\b'), 'appendix pointer'),
    (re.compile(r'contract\.md#'), 'contract anchor'),
)
GITHUB_REMOTE = re.compile(r'^(?:(?:https?|ssh|git)://(?:[^@/]+@)?|[^@/:]+@)?github\.com[:/]'
                           r'([^/\s]+/[^/\s]+?)(?:\.git)?/?$', re.IGNORECASE)
BASELINE_RED = re.compile(r'^[A-Z][A-Z0-9]*-\d+(?:\.\d+)* - \S')
FAILURE_CONCLUSIONS = ('failure', 'timed_out', 'startup_failure')


class GhError(Exception):
    pass


class NotOnGitHub(GhError):
    pass


class Report:
    def __init__(self, path):
        self.path = path
        self.errors = 0

    def error(self, rule, line, text):
        self.errors += 1
        print(f'{rule} {self.path}:{line} {text}')

    def info(self, rule, line, text):
        print(f'{rule} {self.path}:{line} info: {text}')

    def warn(self, rule, line, text):
        print(f'{rule} {self.path}:{line} warning: {text}')


# --- text helpers ---------------------------------------------------------------------------

def numbered(text):
    """Yield (line number, line, inside_fence). A fence line itself counts as inside."""
    fence = None
    for number, line in enumerate(text.splitlines(), 1):
        stripped = line.lstrip()
        marker = stripped[:3] if stripped[:3] in ('```', '~~~') else None
        if fence is None and marker:
            fence = marker
            yield number, line, True
        elif fence is not None and marker == fence:
            fence = None
            yield number, line, True
        else:
            yield number, line, fence is not None


def read_text(report, path):
    try:
        return Path(path).read_bytes().decode('utf-8')
    except OSError as error:
        report.error('IO', 1, f'cannot read file: {error.strerror or error}')
    except UnicodeDecodeError:
        report.error('IO', 1, 'file is not valid UTF-8')
    return None


def h2_sections(text):
    """{heading: (first body line, last body line)} for `## ` headings outside fences."""
    found = {}
    current, start = None, 0
    last = 0
    for number, line, fenced in numbered(text):
        last = number
        if not fenced and line.startswith('## '):
            if current is not None:
                found.setdefault(current, (start, number - 1))
            current, start = line[3:].strip(), number + 1
    if current is not None:
        found.setdefault(current, (start, last))
    return found


def check_pointers(report, rule, text):
    for number, line, _ in numbered(text):
        for pattern, label in PROTOCOL_POINTERS:
            if pattern.search(line):
                report.error(rule, number, f'{label} ({pattern.pattern}): restate nothing, point at nothing')


def parse_loopmd_keys(text):
    """(keys, lines): the opening key: value lines of a LOOP.md, before its first `## ` heading."""
    keys, where = {}, {}
    for number, line, fenced in numbered(text):
        if fenced:
            continue
        if line.startswith('## '):
            break
        match = re.match(r'^([a-z][a-z0-9-]*):\s*(.*?)\s*$', line)
        if match and match.group(1) not in keys:
            keys[match.group(1)] = match.group(2)
            where[match.group(1)] = number
    return keys, where


# --- git / gh -------------------------------------------------------------------------------

def run(argv, cwd=None):
    try:
        return subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as error:
        raise GhError(f'{argv[0]} failed to run: {error}')


def origin_slug(repo):
    """owner/repo of a github.com origin. NotOnGitHub when origin is anywhere else, since GitHub then
    holds no branch protection to read and the required checks are unknowable."""
    result = run(['git', '-C', str(repo), 'config', '--get', 'remote.origin.url'])
    if result.returncode != 0:
        raise GhError('no git remote named origin')
    url = result.stdout.strip()
    match = GITHUB_REMOTE.match(url)
    if not match:
        raise NotOnGitHub(f'origin {url!r} is not a github.com remote')
    return match.group(1)


def gh_api_status(endpoint):
    """(HTTP status, parsed body, message) for `gh api -i <endpoint>`. Decided on the status code,
    never on text in the output; no status line at all (gh failed before a response) is an error."""
    result = run(['gh', 'api', '-i', endpoint])
    head, _, body = result.stdout.replace('\r\n', '\n').partition('\n\n')
    status = re.match(r'^HTTP/\S+ (\d{3})', head)
    if not status:
        raise GhError(f'gh api {endpoint} gave no HTTP response: '
                      f'{(result.stderr or result.stdout).strip()[:200]}')
    try:
        data = json.loads(body) if body.strip() else None
    except ValueError:
        raise GhError(f'gh api {endpoint} returned invalid JSON')
    message = data.get('message', '') if isinstance(data, dict) else ''
    return int(status.group(1)), data, message


def ci_required_names(value):
    """The check names a `ci-required` value declares: comma-separated, a name holding a comma in
    double quotes, or `none`."""
    if value.strip().lower() == 'none':
        return set()
    return {c.strip() for c in next(csv.reader([value], skipinitialspace=True), []) if c.strip()}


def required_checks(repo):
    """Required status check names on main: every active ruleset that applies to main plus classic
    branch protection. The rulesets endpoint answers 200 for any repository gh can see, so anything
    else is an error; the only 404 read as empty is classic protection's `Branch not protected`."""
    slug = origin_slug(repo)
    names = set()
    status, data, message = gh_api_status(f'repos/{slug}/rules/branches/main?per_page=100')
    if status != 200 or not isinstance(data, list):
        raise GhError(f'rulesets for {slug} main: HTTP {status} {message}'.rstrip()
                      + ' (gh cannot see the repository or branch)')
    for rule in data:
        if isinstance(rule, dict) and rule.get('type') == 'required_status_checks':
            checks = (rule.get('parameters') or {}).get('required_status_checks') or []
            names.update(c.get('context') for c in checks if c.get('context'))
    status, data, message = gh_api_status(f'repos/{slug}/branches/main/protection/required_status_checks')
    if status == 200 and isinstance(data, dict):
        names.update(data.get('contexts') or [])
        names.update(c.get('context') for c in data.get('checks') or [] if c.get('context'))
    elif not (status == 404 and message == 'Branch not protected'):
        raise GhError(f'branch protection for {slug} main: HTTP {status} {message}'.rstrip())
    return names


def main_required_state(repo, required):
    """('red'|'green'|'undecided', detail) for the latest run of each required check on main's head,
    read from the check runs and the legacy commit statuses; a name red in either is red. Only `success` is green; pending, missing, skipped or neutral decide
    nothing. GhError when the check runs cannot be read."""
    slug = origin_slug(repo)
    result = run(['gh', 'api', '--paginate', f'repos/{slug}/commits/main/check-runs?per_page=100',
                  '--jq', '.check_runs[] | {id, name, status, conclusion}'], cwd=str(repo))
    if result.returncode != 0:
        raise GhError(f'check runs on main: {(result.stderr or result.stdout).strip()[:200]}')
    latest = {}
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        try:
            item = json.loads(line)
        except ValueError:
            raise GhError('check runs on main returned invalid JSON')
        name = item.get('name') if isinstance(item, dict) else None
        if name in required and (name not in latest or (item.get('id') or 0) > (latest[name].get('id') or 0)):
            latest[name] = item
    # Legacy commit statuses: a required name may report only here, or here as well as a check run.
    result = run(['gh', 'api', f'repos/{slug}/commits/main/status?per_page=100'], cwd=str(repo))
    if result.returncode != 0:
        raise GhError(f'commit statuses on main: {(result.stderr or result.stdout).strip()[:200]}')
    try:
        statuses = json.loads(result.stdout or '{}').get('statuses') or []
    except (ValueError, AttributeError):
        raise GhError('commit statuses on main returned invalid JSON')
    outcomes = {}
    for name, r in latest.items():
        done = r.get('status') == 'completed'
        outcomes.setdefault(name, []).append(
            'red' if done and r.get('conclusion') in FAILURE_CONCLUSIONS
            else 'green' if done and r.get('conclusion') == 'success' else 'undecided')
    for item in statuses:
        name = item.get('context') if isinstance(item, dict) else None
        if name in required:
            state = item.get('state')
            outcomes.setdefault(name, []).append(
                'red' if state in ('failure', 'error') else 'green' if state == 'success' else 'undecided')
    red = sorted(n for n, o in outcomes.items() if 'red' in o)
    if red:
        return 'red', ', '.join(red)
    if set(outcomes) == required and all(set(o) == {'green'} for o in outcomes.values()):
        return 'green', 'every required check succeeded'
    return 'undecided', 'required checks pending, missing or not a pass'


def split_globs(value):
    """Comma-separated items; a comma inside `{...}` belongs to the glob. Backticks are stripped."""
    items, depth, start = [], 0, 0
    for i in range(len(value) + 1):
        c = value[i] if i < len(value) else None
        if c == '{':
            depth += 1
        elif c == '}':
            depth = max(0, depth - 1)
        elif (c == ',' and depth == 0) or c is None:
            item = value[start:i].strip().strip('`').strip()
            if item:
                items.append(item)
            start = i + 1
    return items


# --- LOOP.md ---------------------------------------------------------------------------------

def lint_gate_declarations(report, text):
    """Match loop-pi's unfenced Mutexes grammar, not prose or illustrative gate mentions."""
    active, fence = False, None
    names, commands = set(), set()
    for number, line in enumerate(text.splitlines(), 1):
        stripped = line.strip()
        marker = re.match(r'^(`{3,}|~{3,})', stripped)
        if marker:
            token = marker[1]
            if fence is None:
                fence = token
            elif token[0] == fence[0] and len(token) >= len(fence):
                fence = None
            continue
        if fence is not None:
            continue
        if re.match(r'^#{1,2}(?:\s|$)', stripped):
            active = stripped == '## Mutexes'
            continue
        if not active or not re.match(r'^-\s+gate:', stripped):
            continue
        declaration = re.fullmatch(r'-\s+gate:\s*([^|]+)\|(.*)', stripped)
        if not declaration:
            report.error('L2', number, 'malformed explicit gate declaration in LOOP.md')
            continue
        name, command = (part.strip() for part in declaration.groups())
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,127}', name) or not command or '\0' in command:
            report.error('L2', number, 'invalid gate name or empty command in LOOP.md')
            continue
        if name in names or command in commands:
            report.error('L2', number, 'duplicate gate name or command in LOOP.md')
        names.add(name)
        commands.add(command)


def lint_loopmd(path, offline, repo_arg=None):
    report = Report(path)
    text = read_text(report, path)
    if text is None:
        return report
    size = len(text.encode('utf-8'))
    if size > LOOPMD_MAX:
        report.error('L1', 1, f'LOOP.md is {size} bytes, limit {LOOPMD_MAX}')
    keys, where = parse_loopmd_keys(text)
    first = text.splitlines()[0] if text else ''
    if not re.match(r'^# Loop: \S', first):
        report.error('L2', 1, 'line 1 must be `# Loop: <repo>`')

    def need(key, check, hint):
        if key not in keys:
            report.error('L2', 1, f'missing key `{key}:` ({hint})')
        elif not check(keys[key]):
            report.error('L2', where[key], f'invalid `{key}:` value {keys[key]!r} ({hint})')

    need('tier', lambda v: v in ('routine', 'guarded'), 'routine | guarded')
    need('gate', lambda v: bool(v) and v.lower() != 'none', 'the local gate command')
    need('ci-required', lambda v: bool(v), 'required check names, or none')
    # Kept for LOOP.md files that still carry them; only the pre-green eligibility rule needed them.
    for key in ('release-on-push', 'deploy-on-push'):
        if key in keys and keys[key] not in ('yes', 'no'):
            report.error('L2', where[key], f'invalid `{key}:` value {keys[key]!r} (yes | no)')
    need('grafana-stack', lambda v: v == 'none' or bool(re.match(r'^[a-z0-9][a-z0-9-]*$', v)),
         'a stack slug or none')
    if 'ci-status' in keys and '{sha}' not in keys['ci-status']:
        report.error('L2', where['ci-status'], '`ci-status:` must contain {sha} for the exact commit')
    if 'ci-required' in keys and ci_required_names(keys['ci-required']) and 'ci-status' not in keys:
        try:
            origin_slug(Path(repo_arg) if repo_arg else Path(path).resolve().parent)
        except NotOnGitHub:
            report.warn('L2', where['ci-required'], 'non-GitHub origin has required CI but no `ci-status:` '
                                                   'command; CI waits cannot verify a SHA')
        except GhError:
            pass  # The online required-check read below diagnoses unreadable origins.
    if 'ci-max-minutes' in keys and not re.match(r'^[1-9][0-9]*$', keys['ci-max-minutes']):
        report.error('L2', where['ci-max-minutes'], 'invalid `ci-max-minutes:`, want a positive integer')
    if 'guarded-paths' in keys and not split_globs(keys['guarded-paths']):
        report.error('L2', where['guarded-paths'], '`guarded-paths:` is empty; drop the key or name globs')
    if 'baseline-red' in keys and not BASELINE_RED.match(keys['baseline-red']):
        report.error('L2', where['baseline-red'], 'invalid `baseline-red:`, want `<TASK-ID> - <reason>` '
                                                  'with a TASK-ID like ABC-0123 or ABC-0123.01')

    if 'ci-required' in keys:
        if offline:
            report.info('L2', where['ci-required'],
                        'skipped (--offline): ci-required was not compared with the required checks')
        else:
            declared = ci_required_names(keys['ci-required'])
            try:
                actual = required_checks(Path(repo_arg) if repo_arg else Path(path).resolve().parent)
            except NotOnGitHub:
                report.info('L2', where['ci-required'], 'required checks not verifiable (not on GitHub)')
            except GhError as error:
                report.error('L2', where['ci-required'], f'required checks unreadable: {error}')
            else:
                if declared != actual:
                    report.error('L2', where['ci-required'],
                                 f'ci-required {sorted(declared)} differs from required checks '
                                 f'{sorted(actual)}')
                check_main_ci(report, Path(repo_arg) if repo_arg else Path(path).resolve().parent,
                              actual, where.get('baseline-red', where['ci-required']), 'baseline-red' in keys)

    for number, line, _ in numbered(text):
        for match in re.finditer(r'\b\d{4}-\d\d-\d\d\b', line):
            report.error('L3', number, f'dated fact {match.group(0)}')
        for match in re.finditer(r'\bloop\d+\b', line, re.IGNORECASE):
            report.error('L3', number, f'loop-numbered fact {match.group(0)}')
        for match in re.finditer(r'\b[0-9a-f]{40}\b', line):
            report.error('L3', number, f'git SHA {match.group(0)[:12]}...')
    check_pointers(report, 'L4', text)
    lint_gate_declarations(report, text)
    return report


def check_main_ci(report, repo, required, line, baseline_red):
    """Warn when `baseline-red` looks stale or is missing, from the required checks on main's head."""
    if not required:
        report.info('L2', line, 'no required checks, so main\'s CI was not read')
        return
    try:
        state, detail = main_required_state(repo, required)
    except GhError as error:
        report.info('L2', line, f'CI on main unreadable: {error}')
        return
    if state == 'green' and baseline_red:
        report.warn('L2', line, 'baseline-red may be stale: every required check on main\'s head is green')
    elif state == 'red' and not baseline_red:
        report.warn('L2', line, f'main is red ({detail}): add baseline-red with an owning task, '
                                'or fix main first')
    else:
        report.info('L2', line, f'CI on main: {state} ({detail})')


# --- charter (C) -----------------------------------------------------------------------------

def parse_charter_keys(text):
    """({key: value}, {key: line}): the `key: value` lines before the first `## ` heading, outside fences.
    Indented lines below a key continue its value."""
    keys, where = {}, {}
    current = None
    for number, line, fenced in numbered(text):
        if fenced:
            current = None
            continue
        if line.startswith('## '):
            break
        match = re.match(r'^([a-z][a-z0-9-]*):\s*(.*?)\s*$', line)
        if match and match.group(1) not in keys:
            current = match.group(1)
            keys[current] = match.group(2)
            where[current] = number
        elif current and line[:1] in (' ', '\t') and line.strip():
            keys[current] = (keys[current] + '\n' + line.strip()).strip()
        elif not line.strip():
            continue
        elif not match:
            current = None
    return keys, where


def check_charter_header(report, text, path):
    first = text.splitlines()[0] if text else ''
    match = CHARTER_HEADER.match(first)
    if not match:
        report.error('C2', 1, 'line 1 must be `# Charter: <repo> loop<N>`')
        return
    named = CHARTER_FILE.match(Path(path).name)
    if named and named.group(1) != match.group(2):
        report.error('C2', 1, f'header says loop{match.group(2)} but the file name says loop{named.group(1)}')


def first_wave_rows(text, span):
    """(header line, data row count) of the first markdown table inside the section span, else None."""
    lines = text.splitlines()
    header = None
    rows = 0
    for number in range(span[0], span[1] + 1):
        line = lines[number - 1].strip() if number - 1 < len(lines) else ''
        if header is None:
            if line.startswith('|') and number < span[1] and re.match(r'^\|[\s:|-]+\|?$', lines[number].strip()):
                header = number
            continue
        if number == header + 1:
            continue
        if line.startswith('|'):
            rows += 1
        else:
            break
    return None if header is None else (header, rows)


def lint_charter(path):
    report = Report(path)
    text = read_text(report, path)
    if text is None:
        return report
    size = len(text.encode('utf-8'))
    if size > CHARTER_MAX:
        report.error('C1', 1, f'charter is {size} bytes, limit {CHARTER_MAX}')
    check_charter_header(report, text, path)
    keys, where = parse_charter_keys(text)
    for key in CHARTER_KEYS:
        if key not in keys:
            report.error('C3', 1, f'missing key `{key}:`')
        elif not keys[key]:
            report.error('C3', where[key], f'empty `{key}:`')
    for key, value in keys.items():
        if value and PLACEHOLDER.search(value):
            report.error('C3', where[key], f'`{key}:` still holds a template placeholder')
    if keys.get('harness') and keys['harness'] not in HARNESSES:
        report.error('C3', where['harness'], f'invalid `harness:` {keys["harness"]!r} ({" | ".join(HARNESSES)})')
    if keys.get('lanes') and not re.fullmatch(r'[1-9][0-9]*', keys['lanes']):
        report.error('C3', where['lanes'], f'invalid `lanes:` {keys["lanes"]!r}, want a positive integer')
    if keys.get('budget') and not BUDGET_VALUE.match(keys['budget']):
        report.error('C3', where['budget'], f'invalid `budget:` {keys["budget"]!r}, want an ISO UTC time or none')
    sections = h2_sections(text)
    if 'First wave' not in sections:
        report.error('C4', 1, 'missing `## First wave` section')
    else:
        table = first_wave_rows(text, sections['First wave'])
        if table is None:
            report.error('C4', sections['First wave'][0], '`## First wave` has no markdown table')
        elif table[1] > FIRST_WAVE_ROWS:
            report.warn('C4', table[0], f'first wave has {table[1]} rows; about {FIRST_WAVE_ROWS} is the limit, '
                                        'the root grows the queue from the board')
    if keys.get('standing'):
        line = where['standing']
        match = STANDING_VALUE.match(keys['standing'])
        if not match:
            report.error('C5', line, '`standing:` must be `<absolute path> sha256=<64 hex>`')
        else:
            standing = Path(match.group(1))
            try:
                actual = hashlib.sha256(standing.read_bytes()).hexdigest()
            except OSError as error:
                report.error('C5', line, f'standing file unreadable: {error.strerror or error}')
            else:
                if actual != match.group(2):
                    report.error('C5', line, f'standing file sha256 is {actual}, the charter records '
                                             f'{match.group(2)}')
    return report


# --- queue (Q) -------------------------------------------------------------------------------

def charter_exclusions(value):
    """(excluded task IDs, excluded labels) from an `exclude:` value. Parenthesised titles are ignored,
    so an ID mentioned inside one is not excluded."""
    labels = {m.group(1).lower() for m in EXCLUDE_LABEL.finditer(value)}
    plain = re.sub(r'\([^)]*\)', ' ', EXCLUDE_LABEL.sub(' ', value))
    return {m.group(0).upper() for m in TASK_ID.finditer(plain)}, labels | set(ALWAYS_EXCLUDED_LABELS)


def ready_rows(text):
    """[(line, task id)]: the first task ID of every ready row. Table rows and list items count; with a
    `## Ready` heading only its sections do, otherwise everything outside the not-ready sections."""
    sections = h2_sections(text)
    ready = [span for name, span in sections.items() if name.lower().startswith('ready')]
    skipped = [span for name, span in sections.items() if NOT_READY_SECTION.match(name)]
    rows = []
    for number, line, fenced in numbered(text):
        if fenced or line.startswith('#'):
            continue
        if ready:
            if not any(a <= number <= b for a, b in ready):
                continue
        elif any(a <= number <= b for a, b in skipped):
            continue
        if not (line.lstrip().startswith('|') or LIST_ITEM.match(line)):
            continue
        found = TASK_ID.search(line)
        if found:
            rows.append((number, found.group(0).upper()))
    return rows


def backlog_task(repo, task_id):
    """(status text, label set) from `backlog task view <id> --plain`; GhError when it cannot be read."""
    result = run(['backlog', 'task', 'view', task_id, '--plain'], cwd=str(repo))
    if result.returncode != 0:
        raise GhError(f'backlog task view {task_id} failed: {(result.stderr or result.stdout).strip()[:160]}')
    status, labels = None, set()
    for line in result.stdout.splitlines():
        if status is None and line.startswith('Status:'):
            status = re.sub(r'^[^\w]+', '', line[len('Status:'):].strip())
        elif line.startswith('Labels:'):
            labels = {label.strip().lower() for label in line[len('Labels:'):].split(',') if label.strip()}
    if status is None:
        raise GhError(f'backlog task view {task_id} printed no Status line')
    return status, labels


def lint_queue(charter_path, queue_path, repo_arg=None):
    report = Report(queue_path)
    charter = read_text(report, charter_path)
    queue = read_text(report, queue_path)
    if charter is None or queue is None:
        return report
    # The charter's own shape is `loop-lint charter`'s job; the queue check needs only its header and exclusions.
    charter_report = Report(charter_path)
    check_charter_header(charter_report, charter, charter_path)
    keys, where = parse_charter_keys(charter)
    if 'exclude' not in keys:
        charter_report.error('C3', 1, 'missing key `exclude:`')
    report.errors += charter_report.errors
    if charter_report.errors:
        return report
    repo = Path(repo_arg) if repo_arg else Path(charter_path).resolve().parent.parent
    ids, labels = charter_exclusions(keys['exclude'])
    seen = set()
    for number, task_id in ready_rows(queue):
        if task_id in seen:
            continue
        seen.add(task_id)
        if task_id in ids:
            report.error('Q1', number, f'{task_id} is in the charter\'s exclude list')
            continue
        try:
            status, task_labels = backlog_task(repo, task_id)
        except GhError as error:
            report.error('Q4', number, f'{task_id}: {error}')
            continue
        if status.lower() == 'done':
            report.error('Q2', number, f'{task_id} is Done')
        for label in sorted(task_labels & labels):
            report.error('Q3', number, f'{task_id} carries the excluded label {label}')
    report.info('Q0', 1, f'{len(seen)} ready task(s) checked against the charter and the board')
    return report


# --- entry -----------------------------------------------------------------------------------

def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('kind', choices=('loopmd', 'charter', 'queue'))
    parser.add_argument('paths', nargs='+', help='loopmd: LOOP.md; charter: charter.md; queue: charter.md QUEUE.md')
    parser.add_argument('--offline', action='store_true', help='loopmd only: skip the checks that need gh')
    parser.add_argument('--repo', help='repository checkout (default: the parent of the codex/ folder)')
    args = parser.parse_args(argv)
    wanted = 2 if args.kind == 'queue' else 1
    if len(args.paths) != wanted:
        parser.error(f'{args.kind} takes {wanted} path argument(s)')
    if args.kind == 'loopmd':
        if args.offline:
            print('loop-lint: --offline, the gh-backed checks are skipped and said so below', file=sys.stderr)
        report = lint_loopmd(args.paths[0], args.offline, args.repo)
    elif args.kind == 'charter':
        report = lint_charter(args.paths[0])
    else:
        report = lint_queue(args.paths[0], args.paths[1], args.repo)
    return 1 if report.errors else 0


if __name__ == '__main__':
    sys.exit(main())
